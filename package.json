{
  "name": "opass-push-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "postinstall": "npm run types",
    "dev": "wrangler dev --local",
    "test": "vitest run && node --test test/*.test.mjs",
    "export:content": "node scripts/export-content.mjs",
    "types": "node -e \"require('node:fs').mkdirSync('.wrangler/types', { recursive: true })\" && wrangler types .wrangler/types/worker-configuration.d.ts",
    "typecheck": "npm run types && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contract:check": "node scripts/check-contract.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run format:check && npm run typecheck && npm run contract:check && npm test && npm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.13",
    "@types/node": "24.13.6",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.135.0",
    "yaml": "2.9.1"
  }
}
